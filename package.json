{
	"name": "unipeq",
	"private": true,
	"version": "1.2.3",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"description": "Parametric EQ control for USB, Bluetooth and network audio devices",
	"scripts": {
		"dev": "vite dev",
		"dev:eqcaps": "vite dev --mode eqcaps",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "npm run i18n:compile && svelte-kit sync || echo ''",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale && node scripts/android-strings.js",
		"i18n:check": "node scripts/check-translations.js",
		"i18n:missing": "node scripts/check-translations.js --write",
		"i18n:apply": "node scripts/apply-translations.js && npm run i18n:missing",
		"i18n:apply_force": "node scripts/apply-translations.js --force",
		"data:snapshot": "node scripts/data-snapshot.ts",
		"icons": "node scripts/render-icons.mjs",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"android": "node scripts/android-install.mjs",
		"android:sync": "vite build && cap sync android",
		"android:sync:debug": "vite build --mode debug && cap sync android",
		"android:release": "node scripts/android-release.mjs",
		"android:hid-spike": "node scripts/android-hid-spike.mjs",
		"release": "node scripts/release.mjs"
	},
	"dependencies": {
		"@capacitor/android": "8.5.3",
		"@capacitor/app": "8.1.2",
		"@capacitor/core": "8.5.3",
		"@capacitor/filesystem": "8.1.5",
		"@capacitor/haptics": "8.0.2",
		"@capacitor/keyboard": "8.0.6",
		"@capacitor/share": "8.0.3",
		"@lucide/svelte": "^1.60.0",
		"@potatosalad775/eqcaps-client": "^0.2.4",
		"@potatosalad775/eqcaps-core": "^0.2.4",
		"@potatosalad775/eqcaps-device-bridge": "^0.2.4",
		"bits-ui": "^2.19.5",
		"peq-link": "github:potatosalad775/uniPEQ_link#semver:^1.2.0",
		"pretendard": "1.3.9",
		"tailwind-merge": "^3.7.0",
		"uni-peq-device-io": "file:native/device-io"
	},
	"devDependencies": {
		"@capacitor/cli": "8.5.3",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"engines": {
		"node": ">=20.19"
	},
	"overrides": {
		"uuid": "^14.0.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"fsevents@2.3.3": true
	}
}

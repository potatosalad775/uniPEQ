{
	"name": "unipeq",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Parametric EQ control for USB, Bluetooth and network audio devices",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "npm run i18n:compile && svelte-kit sync || echo ''",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale",
		"data:snapshot": "node scripts/data-snapshot.ts",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"android": "node scripts/android-install.mjs",
		"android:sync": "vite build && cap sync android",
		"android:sync:debug": "vite build --mode debug && cap sync android",
		"android:hid-spike": "node scripts/android-hid-spike.mjs"
	},
	"dependencies": {
		"@capacitor/android": "8.5.2",
		"@capacitor/app": "8.1.0",
		"@capacitor/core": "8.5.2",
		"@capacitor/filesystem": "8.1.4",
		"@capacitor/haptics": "8.0.2",
		"@capacitor/keyboard": "8.0.5",
		"@capacitor/share": "8.0.3",
		"@lucide/svelte": "^1.52.0",
		"@potatosalad775/eqcaps-client": "^0.2.3",
		"@potatosalad775/eqcaps-core": "^0.2.3",
		"@potatosalad775/eqcaps-device-bridge": "^0.2.3",
		"bits-ui": "^2.19.5",
		"pretendard": "1.3.9",
		"tailwind-merge": "^3.7.0",
		"uni-peq-device-io": "file:native/device-io"
	},
	"devDependencies": {
		"@capacitor/cli": "8.5.2",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^5.0.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"engines": {
		"node": ">=20.19"
	},
	"overrides": {
		"uuid": "^14.0.0",
		"cookie": "^0.7.2"
	}
}

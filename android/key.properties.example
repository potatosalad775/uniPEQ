# Release signing for `npm run android:release`. Copy to key.properties (gitignored) and fill in.
# storeFile is relative to this android/ directory.
storeFile=../keystore.jks
storePassword=
keyAlias=
keyPassword=

# The sideload APK (`npm run android:release -- --sideload`, attached to GitHub releases): its own
# key, not the upload key. Only needed to build it.
sideload.storeFile=../sideload.jks
sideload.storePassword=
sideload.keyAlias=
sideload.keyPassword=

<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive icon's background: the diagonal gradient of resources/icon.svg's #background,
    running corner to corner across the 72 dp the launcher shows of this 108 dp layer and clamped
    beyond it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:startColor="#F4FAFF"
                android:endColor="#CDE5FF" />
        </aapt:attr>
    </path>
</vector>
